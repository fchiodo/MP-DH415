[Unit]
Description=MP-DH415 Flask API (frontend/api/app.py)
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_DIR__/frontend/api
Environment="PATH=__VENV_DIR__/bin"
EnvironmentFile=__REPO_DIR__/.env
# gthread: le connessioni SSE (/api/logs/stream) restano aperte a lungo e con
# worker sync esaurirebbero i processi disponibili bloccando tutta l'API.
# Bind su localhost: l'accesso esterno passa da nginx (porta 80).
ExecStart=__VENV_DIR__/bin/gunicorn --bind 127.0.0.1:5001 --worker-class gthread --workers 1 --threads 8 --timeout 120 app:app
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
